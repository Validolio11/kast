# Supabase (Settings → API у вашому проєкті). Без них Kast працює лише локально.
RENDERER_VITE_SUPABASE_URL=https://xxxx.supabase.co
RENDERER_VITE_SUPABASE_ANON_KEY=eyJ...

# Google Tasks (Google Cloud → APIs & Services → Credentials → OAuth client ID, тип «Desktop app»).
# Без них рядок Google Tasks у Налаштуваннях підказує, що інтеграцію не налаштовано.
MAIN_VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
MAIN_VITE_GOOGLE_CLIENT_SECRET=GOCSPX-...
